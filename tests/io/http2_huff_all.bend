# Esta função compara duas listas octeto a octeto.
def same_go(+xs: List<&2, U32>, +ys: List<&2, U32>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case h1 <> t1 h2 <> t2:
      Bool.and(U32.is_eq(h1, h2), same_go(t1, t2))
    case _ _:
      False{}

