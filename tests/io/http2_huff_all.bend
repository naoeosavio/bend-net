# io (http2_huff_all): os 256 símbolos do Huffman canônico.
# O vetor tem 583 octetos e decodifica para os 256 octetos 0..255.
# A decodificação cobre os comprimentos 5 a 30 e as duas cópias do codec.
# Golden 2.
import Base
import ../../lib/http2.bend as HTTP2
import ../../lib/httpx.bend as HTTPX
import ../../lib/http.bend as HTTP

def b2u(b: Bool) -> U32:
  match b:
    case True{}:
      1
    case False{}:
      0

