# Esta função confere um resultado: 256 octetos na ordem certa.
def all_ok_go(r: Result<&1, &1, U32 & String, List<&2, U32>>) -> U32:
  match r:
    case Fail{e}:
      0
    case Done{+bs}:
      b2u(Bool.and(U32.is_eq(HTTP.x_len32(bs), 256), same_go(bs, expected())))

def main() -> IO(U32):
  do IO<U32>:
    +h2 : U32 = all_ok_go(HTTP2.x_huff_decode(data()))
    +hx : U32 = all_ok_go(HTTPX.x_huff_decode(data()))
    +total : U32 = (h2 + hx : U32)
    u : Unit <- IO.print(U32.show(total))
    IO.pure(U32, total)

#|2
